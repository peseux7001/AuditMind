FROM node:22-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgl1 \
    poppler-utils \
    python3 \
    python3-pip \
    python3-venv \
  && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/paddleocr \
  && /opt/paddleocr/bin/python -m pip install --upgrade pip \
  && /opt/paddleocr/bin/python -m pip install "paddleocr[doc-parser]" paddlepaddle

WORKDIR /workspace

ENV AUDITMIND_PADDLE_OCR_PYTHON=/opt/paddleocr/bin/python
ENV PADDLE_PDX_CACHE_HOME=/workspace/.paddlex-cache

CMD ["sh", "-c", "npm install --omit=dev && node backend/api/server.mjs"]
